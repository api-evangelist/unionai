{
  "opencollection": "1.0.0",
  "info": {
    "name": "Union FlyteAdmin Control Plane API (HTTP/JSON Gateway) Domains API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "client_credentials",
      "accessTokenUrl": "https://{org}.app.union.ai/oauth2/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Domains",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List the domains (e.g. development, staging, production).",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{org}.app.union.ai/api/v1/domains"
          },
          "docs": "List the domains (e.g. development, staging, production)."
        }
      ]
    }
  ],
  "bundled": true
}