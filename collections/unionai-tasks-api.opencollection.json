{
  "opencollection": "1.0.0",
  "info": {
    "name": "Union FlyteAdmin Control Plane API (HTTP/JSON Gateway) Domains Tasks API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "client_credentials",
      "accessTokenUrl": "https://{org}.app.union.ai/oauth2/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Tasks",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Register a versioned task.",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{org}.app.union.ai/api/v1/tasks",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Register a versioned task."
        },
        {
          "info": {
            "name": "List task names (identifiers) in a project/domain.",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{org}.app.union.ai/api/v1/task_ids/:project/:domain",
            "params": [
              {
                "name": "project",
                "value": "",
                "type": "path"
              },
              {
                "name": "domain",
                "value": "",
                "type": "path"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Maximum number of results to return for this page."
              },
              {
                "name": "token",
                "value": "",
                "type": "query",
                "description": "Opaque pagination token returned by the previous page."
              }
            ]
          },
          "docs": "List task names (identifiers) in a project/domain."
        },
        {
          "info": {
            "name": "List versions of a task.",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{org}.app.union.ai/api/v1/tasks/:project/:domain/:name",
            "params": [
              {
                "name": "project",
                "value": "",
                "type": "path"
              },
              {
                "name": "domain",
                "value": "",
                "type": "path"
              },
              {
                "name": "name",
                "value": "",
                "type": "path"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Maximum number of results to return for this page."
              },
              {
                "name": "token",
                "value": "",
                "type": "query",
                "description": "Opaque pagination token returned by the previous page."
              }
            ]
          },
          "docs": "List versions of a task."
        },
        {
          "info": {
            "name": "Get a single versioned task.",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{org}.app.union.ai/api/v1/tasks/:project/:domain/:name/:version",
            "params": [
              {
                "name": "project",
                "value": "",
                "type": "path"
              },
              {
                "name": "domain",
                "value": "",
                "type": "path"
              },
              {
                "name": "name",
                "value": "",
                "type": "path"
              },
              {
                "name": "version",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get a single versioned task."
        }
      ]
    }
  ],
  "bundled": true
}